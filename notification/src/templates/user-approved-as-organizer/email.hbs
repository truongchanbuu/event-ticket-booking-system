<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>You're now an approved organizer!</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        background: #f8fafc;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
      }
      .header {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        padding: 40px 30px;
        text-align: center;
      }
      .header h1 {
        color: white;
        margin: 0;
        font-size: 28px;
        font-weight: 600;
      }
      .content {
        padding: 40px 30px;
      }
      .congrats-text {
        font-size: 18px;
        color: #374151;
        line-height: 1.6;
        margin-bottom: 30px;
      }
      .cta-button {
        display: inline-block;
        background: #10b981;
        color: white;
        padding: 14px 28px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        margin: 10px 5px;
      }
      .steps {
        margin: 30px 0;
      }
      .step {
        display: flex;
        align-items: flex-start;
        margin: 20px 0;
      }
      .step-number {
        background: #10b981;
        color: white;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        margin-right: 15px;
        flex-shrink: 0;
      }
      .footer {
        background: #f8fafc;
        padding: 20px 30px;
        text-align: center;
        color: #6b7280;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>You're now an approved organizer! ✅</h1>
      </div>

      <div class="content">
        <p class="congrats-text">
          Congratulations {{user_name}}!<br /><br />
          Your organizer profile has been approved. You can now create and
          manage events on EventHub.
        </p>

        <div class="steps">
          <h3 style="color: #374151; margin-bottom: 20px">
            Next steps to create your first event:
          </h3>

          <div class="step">
            <div class="step-number">1</div>
            <div>
              <strong>Set up your organizer profile</strong><br />
              <span style="color: #6b7280"
                >Add your bio, profile picture, and contact information</span
              >
            </div>
          </div>

          <div class="step">
            <div class="step-number">2</div>
            <div>
              <strong>Create your first event</strong><br />
              <span style="color: #6b7280"
                >Use our easy event creation tool to get started</span
              >
            </div>
          </div>

          <div class="step">
            <div class="step-number">3</div>
            <div>
              <strong>Promote and manage</strong><br />
              <span style="color: #6b7280"
                >Share your event and track registrations</span
              >
            </div>
          </div>
        </div>

        <div style="text-align: center; margin: 30px 0">
          <a href="{{organizer_dashboard_url}}" class="cta-button"
            >Go to Dashboard</a
          >
          <a
            href="{{create_event_url}}"
            class="cta-button"
            style="background: #667eea"
            >Create First Event</a
          >
        </div>
      </div>

      <div class="footer">
        <p>
          EventHub Team<br />
          Questions?
          <a href="{{organizer_help_url}}" style="color: #10b981"
            >View Organizer Guide</a
          >
        </p>
      </div>
    </div>
  </body>
</html>
