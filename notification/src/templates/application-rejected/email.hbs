<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your event application was rejected</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        background: #f8fafc;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
      }
      .header {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        padding: 40px 30px;
        text-align: center;
      }
      .header h1 {
        color: white;
        margin: 0;
        font-size: 28px;
        font-weight: 600;
      }
      .content {
        padding: 40px 30px;
      }
      .rejection-notice {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
      }
      .reason-box {
        background: #f8fafc;
        border-left: 4px solid #ef4444;
        padding: 15px;
        margin: 20px 0;
      }
      .cta-button {
        display: inline-block;
        background: #667eea;
        color: white;
        padding: 14px 28px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        margin: 10px 5px;
      }
      .footer {
        background: #f8fafc;
        padding: 20px 30px;
        text-align: center;
        color: #6b7280;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Your event application was rejected ❌</h1>
      </div>

      <div class="content">
        <p style="font-size: 18px; color: #374151; line-height: 1.6">
          Hi {{organizer_name}},<br /><br />
          Unfortunately, your application for the following event was not
          approved:
        </p>

        <div class="rejection-notice">
          <div style="font-weight: 600; color: #374151; margin-bottom: 10px">
            {{event_name}}
          </div>
          <div style="color: #6b7280">
            📅 {{event_date}}<br />
            📍 {{event_location}}
          </div>
        </div>

        {{#if rejection_reason}}
        <div class="reason-box">
          <strong style="color: #374151">Reason for rejection:</strong><br />
          <span style="color: #6b7280">{{rejection_reason}}</span>
        </div>
        {{/if}}

        <h3 style="color: #374151">What you can do next:</h3>
        <ul style="color: #6b7280; line-height: 1.6">
          <li>
            Review our
            <a href="{{event_guidelines_url}}" style="color: #667eea"
              >event guidelines</a
            >
            to understand our requirements
          </li>
          <li>Make necessary adjustments to your event plan</li>
          <li>Submit a new application with the updated information</li>
          <li>
            Contact our support team if you have questions about the rejection
          </li>
        </ul>

        <div style="text-align: center; margin: 30px 0">
          <a href="{{resubmit_url}}" class="cta-button"
            >Submit New Application</a
          >
          <a
            href="{{support_url}}"
            class="cta-button"
            style="background: #6b7280"
            >Contact Support</a
          >
        </div>

        <div
          style="
            background: #f0f9ff;
            border: 1px solid #bae6fd;
            border-radius: 8px;
            padding: 15px;
            margin: 20px 0;
          "
        >
          <p style="margin: 0; color: #0c4a6e">
            <strong>💡 Don't give up!</strong> Many successful events required
            multiple submissions. Learn from the feedback and try again.
          </p>
        </div>
      </div>

      <div class="footer">
        <p>
          EventHub Team<br />
          Questions about this decision?
          <a href="{{appeal_url}}" style="color: #ef4444">Submit an Appeal</a>
        </p>
      </div>
    </div>
  </body>
</html>
