<html>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Your event application was rejected</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        background: #f8fafc;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
      }
      .header {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        padding: 40px 30px;
        text-align: center;
      }
      .header h1 {
        color: white;
        margin: 0;
        font-size: 28px;
        font-weight: 600;
      }
      .content {
        padding: 40px 30px;
      }
      .rejection-notice {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
      }
      .reason-box {
        background: #f8fafc;
        border-left: 4px solid #ef4444;
        padding: 15px;
        margin: 20px 0;
      }
      .cta-button {
        display: inline-block;
        background: #667eea;
        color: white;
        padding: 14px 28px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        margin: 10px 5px;
      }
      .footer {
        background: #f8fafc;
        padding: 20px 30px;
        text-align: center;
        color: #6b7280;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h1>Your event application was rejected ❌</h1>
      </div>

      <div class='content'>
        <p style='font-size: 18px; color: #374151; line-height: 1.6'>
          Hi there,<br /><br />
          Unfortunately, your application for the following event was not
          approved:
        </p>

        {{#if payload.reason}}
          <div class='reason-box'>
            <strong style='color: #374151'>Reason for rejection:</strong><br />
            <span style='color: #6b7280'>{{payload.reason}}</span>
          </div>
        {{/if}}

        {{!-- <div style='text-align: center; margin: 30px 0'>
          <a href='{{resubmit_url}}' class='cta-button'>Submit New Application</a>
          <a href='#' class='cta-button' style='background: #6b7280'>Contact
            Support</a>
        </div> --}}

        <div
          style='
            background: #f0f9ff;
            border: 1px solid #bae6fd;
            border-radius: 8px;
            padding: 15px;
            margin: 20px 0;
          '
        >
          <p style='margin: 0; color: #0c4a6e'>
            <strong>💡 Don't give up!</strong>
            Many successful events required multiple submissions. Learn from the
            feedback and try again.
          </p>
        </div>
      </div>

      <div class='footer'>
        <p>
          EventHub Team<br />
          Questions about this decision?
          <a
            href='mailto:truongchanbuu0512@gmail.com?subject=Appeal%20for%20Application%20{{payload.applicationId}}&body=Hello%20EventHub,%0D%0A%0D%0AI%20would%20like%20to%20appeal%20the%20rejection%20of%20my%20event%20application.%0D%0AApplication%20ID:%20{{payload.applicationId}}%0D%0AReason%20Given:%20{{payload.reason}}%0D%0A%0D%0AThank%20you.'
            style='color: #ef4444'
          >
            Submit an Appeal
          </a>.
        </p>
      </div>
    </div>
  </body>
</html>