<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to EventHub!</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        background: #f8fafc;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
      }
      .header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 40px 30px;
        text-align: center;
      }
      .header h1 {
        color: white;
        margin: 0;
        font-size: 28px;
        font-weight: 600;
      }
      .content {
        padding: 40px 30px;
      }
      .welcome-text {
        font-size: 18px;
        color: #374151;
        line-height: 1.6;
        margin-bottom: 30px;
      }
      .cta-button {
        display: inline-block;
        background: #667eea;
        color: white;
        padding: 14px 28px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        margin: 10px 5px;
      }
      .features {
        display: flex;
        gap: 20px;
        margin: 30px 0;
        flex-wrap: wrap;
      }
      .feature {
        flex: 1;
        min-width: 200px;
        text-align: center;
        padding: 20px;
        background: #f8fafc;
        border-radius: 8px;
      }
      .feature-icon {
        font-size: 24px;
        margin-bottom: 10px;
      }
      .footer {
        background: #f8fafc;
        padding: 20px 30px;
        text-align: center;
        color: #6b7280;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Welcome to EventHub! 🎉</h1>
      </div>

      <div class="content">
        <p class="welcome-text">
          Hi {{user_name}},<br /><br />
          Welcome to EventHub! We're excited to have you join our community of
          event enthusiasts and organizers.
        </p>

        <div class="features">
          <div class="feature">
            <div class="feature-icon">🎟️</div>
            <h3>Discover Events</h3>
            <p>Find amazing events happening around you</p>
          </div>
          <div class="feature">
            <div class="feature-icon">📅</div>
            <h3>Create Events</h3>
            <p>Become an organizer and host your own events</p>
          </div>
        </div>

        <div style="text-align: center; margin: 30px 0">
          <a href="{{explore_events_url}}" class="cta-button">Explore Events</a>
          <a
            href="{{become_organizer_url}}"
            class="cta-button"
            style="background: #10b981"
            >Become Organizer</a
          >
        </div>

        <p style="color: #6b7280; font-size: 14px">
          Ready to create your first event?
          <a href="{{organizer_guide_url}}" style="color: #667eea"
            >Check out our organizer guide</a
          >
          to get started.
        </p>
      </div>

      <div class="footer">
        <p>
          EventHub Team<br />
          Need help?
          <a href="{{support_url}}" style="color: #667eea">Contact Support</a>
        </p>
      </div>
    </div>
  </body>
</html>
