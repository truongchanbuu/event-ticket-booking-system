<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your event permit has been approved</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        background: #f8fafc;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
      }
      .header {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        padding: 40px 30px;
        text-align: center;
      }
      .header h1 {
        color: white;
        margin: 0;
        font-size: 28px;
        font-weight: 600;
      }
      .content {
        padding: 40px 30px;
      }
      .event-card {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        margin: 20px 0;
      }
      .event-title {
        font-size: 20px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 10px;
      }
      .event-details {
        color: #6b7280;
        line-height: 1.6;
      }
      .cta-button {
        display: inline-block;
        background: #f59e0b;
        color: white;
        padding: 14px 28px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        margin: 10px 5px;
      }
      .footer {
        background: #f8fafc;
        padding: 20px 30px;
        text-align: center;
        color: #6b7280;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Your event permit has been approved! 🥳</h1>
      </div>

      <div class="content">
        <p style="font-size: 18px; color: #374151; line-height: 1.6">
          Congratulations {{organizer_name}}!<br /><br />
          Your application to host the following event has been approved:
        </p>

        <div class="event-card">
          <div class="event-title">{{event_name}}</div>
          <div class="event-details">
            📅 <strong>Date:</strong> {{event_date}}<br />
            📍 <strong>Location:</strong> {{event_location}}<br />
            👥 <strong>Expected Attendees:</strong> {{expected_attendees}}
          </div>
        </div>

        <p style="color: #374151; line-height: 1.6">
          Your event is now live and visible to attendees. You can manage
          registrations, send updates, and track attendance through your
          organizer dashboard.
        </p>

        <div style="text-align: center; margin: 30px 0">
          <a href="{{event_dashboard_url}}" class="cta-button"
            >View Event Dashboard</a
          >
          <a
            href="{{event_public_url}}"
            class="cta-button"
            style="background: #667eea"
            >View Public Event Page</a
          >
        </div>

        <div
          style="
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            border-radius: 8px;
            padding: 15px;
            margin: 20px 0;
          "
        >
          <p style="margin: 0; color: #065f46">
            <strong>💡 Pro Tip:</strong> Share your event link on social media
            and with your network to maximize attendance!
          </p>
        </div>
      </div>

      <div class="footer">
        <p>
          EventHub Team<br />
          Need help managing your event?
          <a href="{{organizer_support_url}}" style="color: #f59e0b"
            >Contact Support</a
          >
        </p>
      </div>
    </div>
  </body>
</html>
